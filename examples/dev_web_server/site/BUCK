load("//:defs.bzl", "static_site")

# `buck2 dev //site:site` serves the site on http://localhost:8000/ and rebuilds it as the
# files change. `buck2 run //site:site` serves one build of it.
static_site(
    name = "site",
    pages = glob(["pages/*.html"]),
    server = "//server:server.py",
    theme = "//theme:theme",
)
