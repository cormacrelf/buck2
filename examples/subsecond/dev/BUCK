# Whether a build is for hot patching. `buck2 dev dev.bxl:app` builds with the modifier
# `:subsecond`, and the targets of `//app` select their link on it. A plain `buck2 build` builds
# without it, and `buck2 build //app:main?subsecond` with it (see `PACKAGE`).
constraint_setting(
    name = "hot_patch",
)

constraint_value(
    name = "subsecond",
    constraint_setting = ":hot_patch",
    visibility = ["PUBLIC"],
)
