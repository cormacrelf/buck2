# `buck2 dev dev.bxl:app -- --binary //app:main --lib //app:app` runs the Rust binary `--binary`,
# and patches the code of the crate `--lib` into it when a source file of the crate changes,
# with subsecond (https://crates.io/crates/subsecond).
#
# The targets are built with the modifier `//dev:subsecond`, on which they select how they link:
# `--binary` with `SUBSECOND_LINK = "fat"`, and `--lib` with `SUBSECOND_LINK = "thin"` and
# `-Clink-dead-code`. A plain `buck2 build` of them links as usual.
#
# Only Linux is supported: ThinLink, the toolchain's linker, handles ELF only.

# Builds for hot patching. See `dev/BUCK`.
MODIFIERS = ["root//dev:subsecond"]

def _app(ctx):
    binary = ctx.configured_targets(ctx.cli_args.binary, modifiers = MODIFIERS)
    lib = ctx.configured_targets(ctx.cli_args.lib, modifiers = MODIFIERS)
    exe = ctx.analysis(binary).providers()[DefaultInfo].default_outputs[0]

    # The crate as a shared library. ThinLink links it as a patch: only the crate's own code.
    patch = ctx.analysis(lib).providers()[DefaultInfo].sub_targets["cdylib"][DefaultInfo].default_outputs[0]

    # The server runs ThinLink here, so it is built for this machine, without the modifiers.
    thinlink = ctx.configured_targets("toolchains//:thinlink")
    thinlink = ctx.analysis(thinlink).providers()[RunInfo]
    server = cmd_args(
        "python3",
        ctx.fs.source("server/server.py"),
        "--thinlink",
        thinlink,
        # gpui needs a Vulkan driver, which `nixVulkan` from the dev shell gives it.
        "--runner",
        "nixVulkan",
    )
    return [
        DefaultInfo(),
        DevInfo(
            # The command names the server script and ThinLink, so a change to either
            # restarts the server, and so the app, which the new server builds again. The
            # app's binary is not in the command: a new binary would then restart the server.
            # It is an output, which the server asks for when it starts.
            server = server,
            # The patch does not depend on the binary, so a new patch leaves the binary the
            # one that is running.
            outputs = {"exe": exe, "patch": patch},
            # Only a change to the patched crate can go into a patch. `stale` tells the server
            # whether every change since the running binary was built is in it.
            scopes = {"lib": [lib.label]},
        ),
    ]

app = bxl_main(
    impl = _app,
    cli_args = {
        "binary": cli_args.target_label(doc = "The binary to run. It must depend on `lib`."),
        "lib": cli_args.target_label(doc = "The crate to patch while the binary runs."),
    },
)
