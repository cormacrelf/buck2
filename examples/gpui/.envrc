# shellcheck shell=bash

# nix print-dev-env exports a temporary NIX_BUILD_TOP and the usual temporary directory variables.
# Once that directory is cleaned up, a later reload can feed its stale path back into Nix.
unset NIX_BUILD_TOP TMP TMPDIR TEMP TEMPDIR

watch_file nix/*.nix nix/patches/*.patch

# .gpu_driver, which git ignores, chooses the GPU driver that `nixVulkan` runs the app with: nvidia,
# mesa (Intel and AMD), or nothing for none. See nix/gpu.nix. nixGL reads the version of the
# host's NVIDIA driver, which needs --impure.
watch_file .gpu_driver
gpu_driver="$(tr -d '[:space:]' < .gpu_driver 2>/dev/null)"
case "$gpu_driver" in
  "") use flake . ;;
  nvidia) use flake .#nvidia --impure ;;
  mesa) use flake .#mesa ;;
  *)
    log_error ".gpu_driver names '$gpu_driver'; write nvidia, mesa or nothing to it"
    use flake .
    ;;
esac
