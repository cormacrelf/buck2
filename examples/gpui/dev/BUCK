# Whether a build is for hot patching. `buck2 dev dev.bxl:app` builds for `:subsecond`, and the
# targets of `//app` select their link on it. A plain `buck2 build` builds for the default
# platform, without it.
constraint_setting(
    name = "hot_patch",
)

constraint_value(
    name = "subsecond",
    constraint_setting = ":hot_patch",
    visibility = ["PUBLIC"],
)

# The default platform, built for hot patching with subsecond.
platform(
    name = "subsecond_platform",
    constraint_values = [":subsecond"],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)
