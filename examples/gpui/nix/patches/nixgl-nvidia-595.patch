From-upstream: nix-community/nixGL @ b6105297e6f0cd041670c3e8628394d4ee247ed5

Combined fix for NVIDIA driver 595.71.05 compatibility. Three changes:

  1. Remove `kernel = null` from nvidiaLibsOnly override. Upstream nixpkgs
     dropped the `kernel` arg from `nvidia-x11/generic.nix`, so passing it
     now errors with "unexpected argument 'kernel'".
     (From nix-community/nixGL PR #221, commit 5a49a7b7.)

  2. Broaden /proc/driver/nvidia/version regex. The driver's version file
     changed from "Module  VERSION" to "Module for x86_64  VERSION" (and
     the aarch64 equivalent), so the old regex returned null.
     (From nix-community/nixGL PR #221, commit 894cbfcd.)

  3. Use a runtime glob for the Vulkan ICD json. Older drivers shipped
     nvidia_icd.x86_64.json, but 595.71.05 ships plain nvidia_icd.json.
     Build a NVIDIA_ICD bash array via glob so both layouts work.
     (Local fix — no upstream PR yet.)

Drop this patch once https://github.com/nix-community/nixGL/pull/221 (or
a follow-up) lands upstream with all three fixes.

--- a/nixGL.nix
+++ b/nixGL.nix
@@ -87,7 +87,6 @@

       nvidiaLibsOnly = nvidiaDrivers.override {
         libsOnly = true;
-        kernel = null;
       };

       nixGLNvidiaBumblebee = writeExecutable {
@@ -122,6 +121,8 @@
             "export VK_LAYER_PATH=${vulkan-validation-layers}/share/vulkan/explicit_layer.d"}
             NVIDIA_JSON=(${nvidiaLibsOnly}/share/glvnd/egl_vendor.d/*nvidia.json)
             ${lib.optionalString enable32bits "NVIDIA_JSON32=(${nvidiaLibsOnly.lib32}/share/glvnd/egl_vendor.d/*nvidia.json)"}
+            ${lib.optionalString (api == "Vulkan") "NVIDIA_ICD=(${nvidiaLibsOnly}/share/vulkan/icd.d/nvidia_icd*.json)"}
+            ${lib.optionalString (api == "Vulkan" && enable32bits) "NVIDIA_ICD32=(${nvidiaLibsOnly.lib32}/share/vulkan/icd.d/nvidia_icd*.json)"}

             ${''export __EGL_VENDOR_LIBRARY_FILENAMES=''${NVIDIA_JSON[*]}${
               lib.optionalString enable32bits
@@ -131,9 +132,9 @@

               ${
                 lib.optionalString (api == "Vulkan")
-                ''export VK_ICD_FILENAMES=${nvidiaLibsOnly}/share/vulkan/icd.d/nvidia_icd.x86_64.json${
+                ''export VK_ICD_FILENAMES=''${NVIDIA_ICD[*]}${
                   lib.optionalString enable32bits
-                  ":${nvidiaLibsOnly.lib32}/share/vulkan/icd.d/nvidia_icd.i686.json"
+                  '':''${NVIDIA_ICD32[*]}''
                 }"''${VK_ICD_FILENAMES:+:$VK_ICD_FILENAMES}"''
               }
               export LD_LIBRARY_PATH=${
@@ -234,8 +235,10 @@
       # Get if from the nvidiaVersionFile
         let
           data = builtins.readFile _nvidiaVersionFile;
-          versionMatch = builtins.match ".*Module  ([0-9.]+)  .*" data;
-        in if versionMatch != null then builtins.head versionMatch else null;
+          # Match version after "Module", "x86_64", or "aarch64" with flexible whitespace
+          # This supports both old format (Module  VERSION) and new format (x86_64  VERSION)
+          versionMatch = builtins.match ".*(Module|x86_64|aarch64)  +([0-9.]+)  +.*" data;
+        in if versionMatch != null then builtins.elemAt versionMatch 1 else null;

       autoNvidia = nvidiaPackages {version = nvidiaVersionAuto; };
     in rec {
