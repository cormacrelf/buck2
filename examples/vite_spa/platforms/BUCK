load(":defs.bzl", "BROWSER", "local_platform", "modifier_transition")

local_platform(
    name = "local",
    cpu = "prelude//cpu:" + ("arm64" if host_info().arch.is_aarch64 else "x86_64"),
    os = "prelude//os:" + ("macos" if host_info().os.is_macos else "linux"),
    visibility = ["PUBLIC"],
)

# To the browser, from wherever: what a dev server, built for the machine it runs on, serves.
modifier_transition(
    name = "browser",
    constraints = BROWSER,
    visibility = ["PUBLIC"],
)
