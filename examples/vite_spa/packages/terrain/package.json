{
  "name": "@fieldnotes/terrain",
  "version": "0.1.0",
  "private": true,
  "description": "A surveyed heightmap. src/generated/ is written by scripts/survey.mjs from terrain.json and is not checked in.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/survey.mjs terrain.json src/generated/terrain.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
