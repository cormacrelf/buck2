[cells]
root = .
prelude = prelude
toolchains = toolchains
none = none

[cell_aliases]
config = prelude
fbcode = none
fbsource = none
buck = none

[external_cells]
  prelude = bundled

[parser]
target_platform_detector_spec = target:root//...->root//platforms:local

[build]
# Local execution with persistent workers on, for `vite.persistent_worker`.
execution_platforms = root//platforms:local

[vite]
# The module transforms run in a persistent worker, which `buck2 dev` keeps for its session.
# `false` starts `node` for each one instead.
persistent_worker = true

[buck2]
file_watcher = watchman
