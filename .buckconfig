[cells]
gh_facebook_buck2 = .
gh_facebook_buck2_shims_meta = shim

[cell_aliases]
root = gh_facebook_buck2

[oss]
internal_cell = fbcode
stripped_root_dirs = buck2
python_module_prefix = buck2

[project]
ignore = \
    app/buck2_explain, \
    app/buck2_trailcam, \
    app_dep_graph_rules, \
    examples, \
    integrations/rust-project/tests, \
    tests/e2e/build, \
    tests/e2e/bxl/fs, \
    tests/e2e/check_dependencies_test, \
    tests/e2e/configurations/cfg_constructor/bxl, \
    tests/e2e/configurations/configuration_alias, \
    tests/e2e/test_prelude, \
    tests/lint_rules, \
    tests/prelude, \
    .jj, \
    .git, \
    target

[rust]
default_edition = 2024
