load("//:resource_defs.bzl", "dev_with_resources", "local_resource")

# Gives the server the process ID of its holder, which a new setup changes.
local_resource(
    name = "db",
    env = {
        "DEV_DB_PID": "pid",
        "DEV_DB_VERSION": "version",
    },
    setup = "setup.py",
    version = "db_version.txt",
)

# Gives the server the same port after every setup.
local_resource(
    name = "cache",
    env = {"DEV_CACHE_PORT": "port"},
    setup = "setup.py",
    version = "cache_version.txt",
)

local_resource(
    name = "broken",
    env = {"DEV_BROKEN_PORT": "port"},
    setup = "setup.py",
    version = "broken_version.txt",
)

local_resource(
    name = "slow",
    env = {"DEV_SLOW_PORT": "port"},
    setup = "setup.py",
    timeout = 2,
    version = "slow_version.txt",
)

dev_with_resources(
    name = "app",
    resources = {
        "cache": ":cache",
        "db": ":db",
    },
    page = "page.txt",
    server = "server.py",
)

dev_with_resources(
    name = "app_broken",
    resources = {"broken": ":broken"},
    page = "page.txt",
    server = "server.py",
)

dev_with_resources(
    name = "app_slow",
    resources = {"slow": ":slow"},
    page = "page.txt",
    server = "server.py",
)
