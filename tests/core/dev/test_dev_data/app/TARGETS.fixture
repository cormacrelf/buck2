load("//:defs.bzl", "concat", "dev_app")

dev_app(
    name = "auto",
    mode = "auto",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
)

dev_app(
    name = "auto_build_on_stale",
    mode = "auto",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
    server_args = ["--build-on-stale"],
)

dev_app(
    name = "all",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
)

dev_app(
    name = "bad_request",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--bad-request"],
)

dev_app(
    name = "pages",
    mode = "all",
    srcs = glob(["pages/*.txt"]),
    server = "server.py",
)

dev_app(
    name = "restart",
    mode = "restart",
    srcs = ["main.txt"],
    server = "server.py",
)

dev_app(
    name = "slow",
    mode = "all",
    srcs = ["main.txt"],
    delay = "delay.txt",
    server = "server.py",
)

dev_app(
    name = "slow_flood",
    mode = "all",
    srcs = ["main.txt"],
    delay = "delay.txt",
    server = "server.py",
    server_args = ["--flood-on-second-build"],
)

dev_app(
    name = "no_connect",
    mode = "restart",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--no-connect"],
)

dev_app(
    name = "crash",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--crash-once"],
)

dev_app(
    name = "run_once",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--exit-after-built"],
)

dev_app(
    name = "too_long",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--too-long"],
)

dev_app(
    name = "inputs",
    mode = "inputs",
    srcs = ["main.txt"],
    server = "server.py",
)

dev_app(
    name = "deep",
    mode = "deep",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
)

dev_app(
    name = "split",
    mode = "split",
    srcs = ["main.txt"],
    deps = [":part"],
    server = "server.py",
)

concat(
    name = "part",
    srcs = ["part.txt"],
)

dev_app(
    name = "built_server",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
    server_check = "check.txt",
)

concat(
    name = "other",
    srcs = ["other.txt"],
)
