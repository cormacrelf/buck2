load("//:defs.bzl", "concat", "dev_app")

dev_app(
    name = "all",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
)

dev_app(
    name = "bad_request",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--bad-request"],
)

dev_app(
    name = "future_version",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--hello-version=3"],
)

dev_app(
    name = "pages",
    mode = "outputs",
    srcs = glob(["pages/*.txt"]),
    server = "server.py",
)

dev_app(
    name = "slow",
    mode = "outputs",
    srcs = ["main.txt"],
    delay = "delay.txt",
    server = "server.py",
)

dev_app(
    name = "slow_flood",
    mode = "outputs",
    srcs = ["main.txt"],
    delay = "delay.txt",
    server = "server.py",
    server_args = ["--flood-on-second-build"],
)

dev_app(
    name = "no_connect",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--no-connect"],
)

dev_app(
    name = "crash",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--crash-once"],
)

dev_app(
    name = "run_once",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--exit-after-built"],
)

dev_app(
    name = "too_long",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--too-long"],
)

dev_app(
    name = "tree",
    mode = "outputs",
    srcs = glob(["tree/**/*.txt"]),
    server = "server.py",
)

dev_app(
    name = "pages_slow",
    mode = "outputs",
    srcs = glob(["pages/*.txt"]),
    delay = "delay.txt",
    server = "server.py",
)

dev_app(
    name = "deep",
    mode = "deep",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
    server_args = ["--all-outputs"],
)

dev_app(
    name = "patch",
    mode = "outputs",
    srcs = glob(["pages/*.txt"]),
    extra_outputs = {"patch": glob(["pages/*.txt"])},
    deps = ["//lib:lib"],
    server = "server.py",
    server_args = ["--all-outputs"],
)

dev_app(
    name = "split",
    mode = "outputs",
    srcs = ["main.txt"],
    deps = [":part"],
    server = "server.py",
)

concat(
    name = "part",
    srcs = ["part.txt"],
)

dev_app(
    name = "built_server",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_check = "check.txt",
)

concat(
    name = "other",
    srcs = ["other.txt"],
)

dev_app(
    name = "multi",
    mode = "outputs",
    srcs = ["main.txt"],
    extra_outputs = {"extra": ["extra.txt"]},
    server = "server.py",
    server_args = ["--all-outputs"],
)

dev_app(
    name = "with_dep",
    mode = "outputs",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
)

dev_app(
    name = "slow_shutdown",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--slow-shutdown"],
)

dev_app(
    name = "configured",
    mode = "outputs",
    srcs = [read_config("dev_test", "src", "main.txt")],
    server = "server.py",
)

dev_app(
    name = "project_log",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--log-in-project"],
)

dev_app(
    name = "slow_watch",
    mode = "deep",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
    watch_delay = "watch_delay.txt",
)

dev_app(
    name = "outputs",
    mode = "outputs",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    extra_outputs = {"extra": ["extra.txt"]},
    server = "server.py",
    server_args = ["--all-outputs"],
)

# `outputs` with a delay for `site`, and none for `extra`.
dev_app(
    name = "outputs_slow",
    mode = "outputs",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    delay = "delay.txt",
    extra_outputs = {"extra": ["extra.txt"]},
    server = "server.py",
)

dev_app(
    name = "scopes",
    mode = "patch",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    scopes = {
        "app": ["self"],
        "both": ["self", "//lib:lib"],
        "lib": ["//lib:lib"],
    },
    server = "server.py",
    server_args = ["--all-outputs"],
)

dev_app(
    name = "scopes_pages",
    mode = "patch",
    srcs = glob(["pages/*.txt"]),
    deps = ["//lib:lib"],
    scopes = {
        "app": ["self"],
        "both": ["self", "//lib:lib"],
        "lib": ["//lib:lib"],
    },
    server = "server.py",
    server_args = ["--all-outputs"],
)

dev_app(
    name = "scopes_slow",
    mode = "patch",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    delay = "delay.txt",
    scopes = {
        "app": ["self"],
        "both": ["self", "//lib:lib"],
        "lib": ["//lib:lib"],
    },
    server = "server.py",
    server_args = ["--all-outputs"],
)

dev_app(
    name = "scopes_site",
    mode = "patch",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    scopes = {"app": ["self"]},
    server = "server.py",
)

dev_app(
    name = "patcher",
    mode = "patch",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    scopes = {"lib": ["//lib:lib"]},
    server = "server.py",
    server_args = ["--all-outputs", "--patcher"],
)

dev_app(
    name = "sidecars",
    mode = "sidecars",
    srcs = ["main.txt"],
    extra_outputs = {
        "check": ["check.txt"],
        "extra": ["extra.txt"],
    },
    server = "server.py",
)

dev_app(
    name = "flood",
    mode = "flood",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--all-outputs"],
)

# A server that defines outputs while it runs, with the handlers of `dev.bxl`. Nothing in its
# graph is in `lib`.
dev_app(
    name = "handlers",
    mode = "outputs",
    srcs = ["main.txt"],
    scopes = {"lib": ["//lib:lib"]},
    handlers = {
        "broken": "root//dev.bxl:broken_handler",
        "owner": "root//dev.bxl:owner",
    },
    server = "server.py",
)

# `site` is built by a persistent worker, `worker.py`.
dev_app(
    name = "worker",
    mode = "outputs",
    srcs = ["main.txt"],
    server = "server.py",
    worker = "worker.py",
)
