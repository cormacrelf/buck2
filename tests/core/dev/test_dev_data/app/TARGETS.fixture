load("//:defs.bzl", "concat", "dev_app")

dev_app(
    name = "auto",
    mode = "auto",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
)

dev_app(
    name = "auto_build_on_stale",
    mode = "auto",
    srcs = ["main.txt"],
    deps = ["//lib:lib"],
    server = "server.py",
    server_args = ["--build-on-stale"],
)

dev_app(
    name = "all",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
)

dev_app(
    name = "bad_request",
    mode = "all",
    srcs = ["main.txt"],
    server = "server.py",
    server_args = ["--bad-request"],
)

dev_app(
    name = "pages",
    mode = "all",
    srcs = glob(["pages/*.txt"]),
    server = "server.py",
)

dev_app(
    name = "restart",
    mode = "restart",
    srcs = ["main.txt"],
    server = "server.py",
)

dev_app(
    name = "slow",
    mode = "all",
    srcs = ["main.txt"],
    delay = "delay.txt",
    server = "server.py",
)

concat(
    name = "other",
    srcs = ["other.txt"],
)
