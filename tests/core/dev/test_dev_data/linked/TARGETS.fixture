load("//:linked.bzl", "associated_app", "hidden_binary", "run_info_app")

associated_app(
    name = "associated",
    lib = "lib.txt",
    server = "server.py",
)

associated_app(
    name = "sidecar",
    extra = "extra.txt",
    lib = "lib.txt",
    server = "server.py",
)

hidden_binary(
    name = "binary",
    args = ["--flag"],
    data = "data.txt",
)

run_info_app(
    name = "run_info",
    binary = ":binary",
    server = "server.py",
)

run_info_app(
    name = "run_info_only",
    binary = ":binary",
    only = [],
    server = "server.py",
)
