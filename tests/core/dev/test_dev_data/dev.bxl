# Bxl functions that `buck2 dev` runs in place of a target, see `test_dev_bxl`, and handlers of
# `DevInfo.handlers`, see `test_dev_handlers`.

def _app(ctx):
    """`app/server.py`, with `site`, the default output of `--target`, and `shout`, which an
    action of this function makes from `site` in capitals. The scope `lib` is `//lib:lib`."""
    target = ctx.configured_targets(ctx.cli_args.target)
    site = ctx.analysis(target).providers()[DefaultInfo].default_outputs[0]
    actions = ctx.bxl_actions().actions
    shout = actions.declare_output("shout.txt")
    actions.run(
        cmd_args("sh", "-c", 'tr a-z A-Z < "$1" > "$2"', "--", site, shout.as_output()),
        category = "shout",
        local_only = True,
    )
    return [
        DefaultInfo(),
        DevInfo(
            server = cmd_args("python3", ctx.fs.source("app/server.py")),
            outputs = {"shout": shout, "site": site},
            scopes = {"lib": [ctx.configured_targets("//lib:lib").label]},
        ),
    ]

app = bxl_main(
    impl = _app,
    cli_args = {"target": cli_args.target_label()},
)

def _nothing(_ctx):
    pass

nothing = bxl_main(impl = _nothing, cli_args = {})

def _no_default_info(ctx):
    return [DevInfo(server = cmd_args("python3", ctx.fs.source("app/server.py")))]

no_default_info = bxl_main(impl = _no_default_info, cli_args = {})

def _owner(ctx):
    """A `buck2 dev` handler: the default output of the target that owns the source file
    `--path`."""
    owner = ctx.uquery().owner(ctx.cli_args.path)
    if len(owner) != 1:
        fail("{} has {} owners".format(ctx.cli_args.path, len(owner)))
    target = ctx.configured_targets(owner[0].label)
    out = ctx.analysis(target).providers()[DefaultInfo].default_outputs[0]
    return [DefaultInfo(default_output = out)]

owner = bxl_main(
    impl = _owner,
    cli_args = {"path": cli_args.string()},
)

def _owner_with_sidecar(ctx):
    """A `buck2 dev` handler: as `owner` for `--path`, with the default output of the owner of
    `--sidecar` as its sidecar `side`."""
    def output_of(path):
        owner = ctx.uquery().owner(path)
        if len(owner) != 1:
            fail("{} has {} owners".format(path, len(owner)))
        providers = ctx.analysis(ctx.configured_targets(owner[0].label)).providers()
        return providers[DefaultInfo].default_outputs[0]

    out = output_of(ctx.cli_args.path)
    return [
        DefaultInfo(default_output = out),
        DevOutput(out, sidecars = {"side": output_of(ctx.cli_args.sidecar)}),
    ]

owner_with_sidecar = bxl_main(
    impl = _owner_with_sidecar,
    cli_args = {"path": cli_args.string(), "sidecar": cli_args.string()},
)

def _broken_handler(_ctx):
    """A handler whose output is not one artifact."""
    return [DefaultInfo()]

broken_handler = bxl_main(impl = _broken_handler, cli_args = {})
